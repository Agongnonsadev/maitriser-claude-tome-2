# Chapitre 19 : Caddy termine le HTTPS, borne la taille des requêtes, et transmet au Comptoir.
{$COMPTOIR_DOMAINE} {
	# Le chat n'a pas besoin de plus de 16 Ko par message (chapitre 18) ; Meta envoie des notifications
	# WhatsApp jusqu'à 3 Mo. Un corps plus gros est refusé (413) avant d'atteindre le Comptoir.
	@whatsapp path /whatsapp
	@autres not path /whatsapp
	request_body @whatsapp {
		max_size 4MB
	}
	request_body @autres {
		max_size 16KB
	}
	reverse_proxy comptoir:8019
	log {
		output stdout
	}
}
