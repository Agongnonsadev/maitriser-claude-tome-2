{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/lancer.sh\" garde_secrets",
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "PowerShell(git commit *)",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/lancer.sh\" garde_secrets",
            "timeout": 60,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
