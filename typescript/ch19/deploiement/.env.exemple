# Chapitre 19 : à copier en .env sur le serveur, puis à remplir (chmod 600 .env). Le fichier .env ne va
# jamais dans Git, ni dans l'image : Docker le lit au démarrage du conteneur.

# Le nom de domaine du Comptoir, qui pointe vers ce serveur (enregistrement DNS A ou AAAA).
COMPTOIR_DOMAINE=comptoir.exemple.com

# La clé du compte de service « comptoir-production », dans l'espace de travail de production (chapitre 18).
ANTHROPIC_API_KEY=remplacez-moi

# WhatsApp (App Dashboard de Meta) : le secret de l'application, le jeton de l'utilisateur système, et une
# chaîne de vérification choisie par vous, saisie aussi dans le champ Verify token de Meta.
COMPTOIR_WHATSAPP_SECRET_APP=remplacez-moi
COMPTOIR_WHATSAPP_JETON=remplacez-moi
COMPTOIR_WHATSAPP_JETON_VERIFICATION=remplacez-moi

# Deux chaînes aléatoires (par exemple : node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))") :
# le sel des empreintes de numéros, et le jeton du tableau de bord (/tableau).
COMPTOIR_SEL_PSEUDONYMES=remplacez-moi
COMPTOIR_TABLEAU_JETON=remplacez-moi

# La surveillance du chapitre 18 (1 pour l'activer, environ 0,00005 $ par message).
COMPTOIR_FILTRE_SURVEILLANCE=0
